POSTGRES_PASSWORD=change-me
# Production only: address:port your reverse proxy forwards to (an internal LAN address, not 0.0.0.0)
FRONTEND_BIND=<lan-ip>:<port>
# Comma-separated, exact domain match. Only these addresses can register.
ALLOWED_EMAIL_DOMAINS=dhbw.example
# Required in production. Without it (local development) mails are printed to the backend log.
RESEND_API_KEY=
MAIL_FROM=free_site <free@noreply.felixkarg.de>
# Public address of the app, used for links in mails.
APP_URL=https://free.felixkarg.de
# Makes the first registration that enters it an admin. Accepted only while no admin exists.
ADMIN_SETUP_CODE=
# Join code of the first course, INF24B, created on backend start if it does not exist yet. Use a long random value.
INITIAL_COURSE_JOIN_CODE=
